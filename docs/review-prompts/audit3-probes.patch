+// ---- N20: a plan kept by Escape, shown again after the document changed ----------------------------
+
+#[test]
+fn n20_a_kept_plan_writes_the_text_it_was_made_from_after_the_document_was_saved_again() {
+    let dir = scratch("probe-parked");
+    let mut a = app_in(&dir);
+    let source = dir.join("Trip.md");
+    std::fs::write(&source, "## One\n\nalpha\n\n## Two\n\nbeta\n").expect("the source");
+    open_now(&mut a, &source);
+    assert!(a.plan_open_active());
+    a.compose();
+    // A change, so that Escape keeps the plan: the second note is unticked.
+    press(&mut a, KeyName::Down);
+    press(&mut a, KeyName::Space);
+    press(&mut a, KeyName::Escape);
+    assert!(a.plan.is_none() && a.plan_parked.is_some());
+    // The owner goes on writing in the document, and saves it.
+    type_text(&mut a, "x");
+    a.command(C::Save);
+    let now = std::fs::read(&source).expect("the source");
+    assert!(now.starts_with(b"x## One"), "{:?}", String::from_utf8_lossy(&now));
+    // Show, then Write the notes.
+    assert!(a.plan_show());
+    assert_eq!(
+        a.plan.as_ref().expect("open").problem(),
+        None,
+        "nothing says the document changed"
+    );
+    a.compose();
+    press(&mut a, KeyName::Enter);
+    let library = dir.join("library");
+    // FAULT: the note is cut from the text of before; line 1 of the file is no heading now.
+    assert_eq!(
+        read(&library.join("Trip").join("One.md")),
+        "# One\n\nalpha\n"
+    );
+    // FAULT: the record names the digest of the file as it is now, which the notes do not hold.
+    let list = runs::list(&library);
+    assert_eq!(list.len(), 1);
+    assert_eq!(
+        list[0].record.source.sha256,
+        mdshared_app::update::sha256_hex(&now)
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
