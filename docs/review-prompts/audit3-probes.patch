+//! Audit 3 probes for `mdedit_core::runs` and the shared library writers, against 6cdeab2.
+//!
+//! Every test here PASSES on the tree under review, and each one asserts the fault: the assert
+//! that carries the finding is marked `FAULT`. Turned round, each is the regression test for its
+//! fix. Nothing here touches a file outside a scratch folder under the temp folder.
+
+use mdedit_core::runs::{self, Gate, Group, Kind, Link, LinkRemoval, NewNote, Record, Request, Source, State};
+use mdshared_app::library;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+static NEXT: AtomicUsize = AtomicUsize::new(0);
+
+fn scratch(tag: &str) -> PathBuf {
+    let n = NEXT.fetch_add(1, Ordering::Relaxed);
+    let dir = std::env::temp_dir()
+        .join("opencode")
+        .join(format!("audit3-probe-{tag}-{}-{n}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).expect("a scratch folder");
+    dir
+}
+
+fn write_file(path: &Path, text: &str) {
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir).expect("its folder");
+    }
+    std::fs::write(path, text).expect("a file");
+}
+
+fn read(path: &Path) -> String {
+    std::fs::read_to_string(path).unwrap_or_default()
+}
+
+/// The gate as the tests of `runs.rs` have it (`TestGate`): the right composition.
+struct FileGate {
+    refuse: bool,
+}
+
+impl Gate for FileGate {
+    fn add_links(&mut self, file: &Path, links: &[Link]) -> Result<(), String> {
+        if self.refuse {
+            return Err("The group's library file has unsaved changes.".to_string());
+        }
+        let text = std::fs::read_to_string(file).map_err(|e| e.to_string())?;
+        let base = file.parent().unwrap_or(Path::new(""));
+        let new = runs::with_links_added(&text, links);
+        if !runs::check_links_added(
+            &library::parse(&text, base),
+            &library::parse(&new, base),
+            links,
+            base,
+        ) {
+            return Err("the file would not read back as its notes".to_string());
+        }
+        mdshared_app::settings::write_atomic(file, &new).map_err(|e| e.to_string())
+    }
+
+    fn remove_links(
+        &mut self,
+        file: &Path,
+        links: &[LinkRemoval],
+        headings: &[Vec<String>],
+    ) -> Result<(), String> {
+        let text = std::fs::read_to_string(file).map_err(|e| e.to_string())?;
+        let base = file.parent().unwrap_or(Path::new(""));
+        let without = runs::with_links_removed(&text, links, base).unwrap_or(text.clone());
+        let new = runs::with_headings_removed(&without, headings, base).unwrap_or(without);
+        if !runs::check_links_removed(
+            &library::parse(&text, base),
+            &library::parse(&new, base),
+            links,
+            base,
+        ) {
+            return Err("the file would not read back as its notes".to_string());
+        }
+        mdshared_app::settings::write_atomic(file, &new).map_err(|e| e.to_string())
+    }
+}
+
+fn note(library: &Path, rel: &str, title: &str, text: &str, sections: &[&str]) -> NewNote {
+    let path = library.join(rel);
+    NewNote {
+        link_path: PathBuf::from(rel),
+        path,
+        text: text.to_string(),
+        from_source: text.to_string(),
+        title: title.to_string(),
+        sections: sections.iter().map(|s| s.to_string()).collect(),
+        ranges: vec![(1, 1)],
+        heading_shift: 0,
+        title_added: false,
+        already: false,
+    }
+}
+
+/// A request as `plan_write::plan_request` builds it: the folders are every note's parent and
+/// the group's folder, sorted by depth.
+fn request(library: &Path, group: &str, created: bool, notes: Vec<NewNote>) -> Request {
+    let source = library.parent().expect("a parent").join("Source.md");
+    if !source.exists() {
+        write_file(&source, "# One\n\ntext\n");
+    }
+    let home = library.join(group);
+    let mut folders: Vec<PathBuf> = notes
+        .iter()
+        .filter_map(|n| n.path.parent().map(Path::to_path_buf))
+        .collect();
+    folders.push(home.clone());
+    folders.sort_by_key(|f| f.components().count());
+    folders.dedup();
+    Request {
+        library: library.to_path_buf(),
+        source,
+        instruction: String::new(),
+        sent: None,
+        group: Group {
+            name: group.to_string(),
+            file: library.join(format!("{group}.md")),
+            created,
+            home,
+        },
+        folders,
+        notes,
+        pictures: Vec::new(),
+    }
+}
+
+const STAMP: &str = "2026-11-21T14:03:11Z";
+
+// ---- N16 -----------------------------------------------------------------------------------------
+
+#[test]
+fn n16_a_note_under_no_section_cannot_be_linked_into_a_group_that_has_a_section() {
+    let dir = scratch("n16");
+    let library = dir.join("library");
+    // The group is there already, with one section: what any earlier split leaves behind.
+    write_file(
+        &library.join("Trip.md"),
+        "# Trip\nhome: Trip\n\n## Tokyo\n\n- [Asakusa](Trip/Tokyo/Asakusa.md)\n",
+    );
+    write_file(&library.join("Trip/Tokyo/Asakusa.md"), "# Asakusa\n");
+    // The pure half first: where the shared writer puts a link that has no section.
+    let link = Link {
+        path: PathBuf::from("Trip/Packing.md"),
+        title: "Packing".to_string(),
+        sections: Vec::new(),
+        line: library::link_line("Packing", Path::new("Trip/Packing.md")),
+    };
+    let old = read(&library.join("Trip.md"));
+    let new = runs::with_links_added(&old, std::slice::from_ref(&link));
+    let parsed = library::parse(&new, &library);
+    let landed = parsed
+        .entries
+        .iter()
+        .find(|e| e.title == "Packing")
+        .expect("the link is written");
+    // FAULT: a link with no section is appended at the end of the file, under the last heading.
+    assert_eq!(landed.sections, vec!["Tokyo".to_string()], "{new}");
+    assert!(
+        !runs::check_links_added(
+            &library::parse(&old, &library),
+            &parsed,
+            std::slice::from_ref(&link),
+            &library
+        ),
+        "FAULT: the check then refuses the write"
+    );
+    // And through the writer: the note is written, the link is refused, for good.
+    let req = request(
+        &library,
+        "Trip",
+        false,
+        vec![note(&library, "Trip/Packing.md", "Packing", "# Packing\n", &[])],
+    );
+    let mut gate = FileGate { refuse: false };
+    let report = runs::write_at(&req, &mut gate, 1, STAMP);
+    assert_eq!(report.notes_written.len(), 1, "the note is on disk");
+    assert_eq!(report.link_failures.len(), 1, "FAULT: and is not linked");
+    assert_eq!(report.state(), Some(State::LinksPending));
+    let record_path = report.record_path.clone().expect("a record");
+    let record = runs::load(&record_path, &library).expect("the record");
+    let again = runs::finish(&record_path, &record, &library, &mut gate);
+    assert_eq!(again.added, 0, "FAULT: Finish fails the same way");
+    assert_eq!(again.failures.len(), 1);
+    let _ = std::fs::remove_dir_all(&dir);
+}
