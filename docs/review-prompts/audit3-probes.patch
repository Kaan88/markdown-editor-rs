+#[test]
+fn n6_prune_deletes_a_record_this_version_cannot_read() {
+    let dir = scratch("n6");
+    let library = dir.join("library");
+    std::fs::create_dir_all(library.join(runs::RUNS_DIR)).expect("the runs folder");
+    let now = runs::now_utc().0;
+    let record = |secs: u64| Record {
+        version: 1,
+        kind: Kind::Split,
+        started: runs::utc(secs),
+        started_secs: secs,
+        state: State::Done,
+        instruction: String::new(),
+        sent: None,
+        source: Source {
+            path: dir.join("Source.md"),
+            len: 0,
+            sha256: String::new(),
+            recycled: false,
+        },
+        group: Group {
+            name: "Trip".to_string(),
+            file: library.join("Trip.md"),
+            created: false,
+            home: library.join("Trip"),
+        },
+        folders: Vec::new(),
+        notes: Vec::new(),
+        pictures: Vec::new(),
+        sections_added: Vec::new(),
+    };
+    // Twenty runs of this week.
+    for i in 0..runs::KEEP_RUNS as u64 {
+        record(now - 60 * (i + 1)).create(&library).expect("a record");
+    }
+    // And one written a minute ago by the next version, whose kind this one does not know.
+    let newer = library.join(runs::RUNS_DIR).join("2026-11-21T14-03-11Z-import.json");
+    let text = record(now - 30)
+        .to_json(&library)
+        .replace("\"kind\": \"split\"", "\"kind\": \"import\"")
+        .replace("\"version\": 1", "\"version\": 2");
+    write_file(&newer, &text);
+    write_file(&newer.with_extension("done"), "started\n");
+    assert!(runs::load(&newer, &library).is_none(), "this version cannot read it");
+    runs::prune(&library, now);
+    // FAULT: the newest record in the folder is deleted, with its .done file.
+    assert!(!newer.exists());
+    assert!(!newer.with_extension("done").exists());
+    assert_eq!(runs::list(&library).len(), runs::KEEP_RUNS, "the twenty stay");
+    let _ = std::fs::remove_dir_all(&dir);
+}
