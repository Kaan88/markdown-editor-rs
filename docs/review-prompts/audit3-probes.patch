+#[test]
+fn n2_finish_links_by_the_whole_path_and_undo_then_keeps_the_lines_and_deletes_the_notes() {
+    let dir = scratch("n2");
+    let library = dir.join("library");
+    std::fs::create_dir_all(&library).expect("the library");
+    let req = request(
+        &library,
+        "Trip",
+        true,
+        vec![note(&library, "Trip/One.md", "One", "# One\n", &[])],
+    );
+    // The library write is refused: the run is left with its notes and no links.
+    let mut refusing = FileGate { refuse: true };
+    let report = runs::write_at(&req, &mut refusing, 3, STAMP);
+    assert_eq!(report.state(), Some(State::LinksPending));
+    let record_path = report.record_path.clone().expect("a record");
+    let record = runs::load(&record_path, &library).expect("the record");
+    assert_eq!(record.notes[0].line, "- [One](Trip/One.md)");
+    // Finish.
+    let mut gate = FileGate { refuse: false };
+    let done = runs::finish(&record_path, &record, &library, &mut gate);
+    assert_eq!(done.added, 1, "{:?}", done.failures);
+    let group = read(&library.join("Trip.md"));
+    // FAULT: the link Finish wrote is the absolute path, not the recorded relative line.
+    assert!(!group.contains("- [One](Trip/One.md)"), "{group}");
+    let whole = library.join("Trip/One.md").to_string_lossy().replace('\\', "/");
+    assert!(group.contains(&whole), "{group}");
+    // Undo: the line does not match the record, so it counts as edited and stays; the note goes.
+    let record = runs::load(&record_path, &library).expect("the record");
+    let plan = runs::prepare(&record);
+    assert_eq!(plan.links_kept.len(), 1, "FAULT: the line reads as edited by the owner");
+    assert_eq!(plan.notes.len(), 1);
+    let undone = runs::undo(&record_path, &record, &library, &mut gate);
+    assert_eq!(undone.removed_notes.len(), 1);
+    assert!(!library.join("Trip/One.md").exists(), "the note is deleted");
+    assert!(
+        read(&library.join("Trip.md")).contains("[One]"),
+        "FAULT: and its line is left, pointing at nothing"
+    );
+    let _ = std::fs::remove_dir_all(&dir);
+}
