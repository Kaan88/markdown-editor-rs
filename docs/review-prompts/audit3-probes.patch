+// ---- N16: a second split into the same group ------------------------------------------------------
+
+#[test]
+fn n16_a_split_into_a_group_that_has_a_section_writes_its_notes_and_links_none() {
+    let (mut a, library, _record, dir) = written("probe-again", SECTIONED);
+    assert!(read(&library.join("Trip.md")).contains("## Tokyo"));
+    // Another document for the same group, with no heading above its notes.
+    let more = dir.join("more");
+    std::fs::create_dir_all(&more).expect("a folder");
+    let second = more.join("Trip.md");
+    std::fs::write(&second, "## Kyoto\n\nthe temples\n\n## Osaka\n\nthe food\n").expect("a file");
+    open_now(&mut a, &second);
+    assert!(a.plan_open_active(), "the plan opens");
+    {
+        let p = a.plan.as_ref().expect("open");
+        assert!(!p.dest.is_new, "the group is the one that is there");
+        assert_eq!(p.problem(), None, "and nothing is said against writing");
+    }
+    a.compose();
+    press(&mut a, KeyName::Enter);
+    assert!(
+        library.join("Trip").join("Kyoto.md").is_file(),
+        "the notes are written"
+    );
+    let said = toast(&a);
+    // FAULT: and then the library file is refused.
+    assert!(
+        said.starts_with("The notes are written, but Trip.md could not be updated"),
+        "{said}"
+    );
+    assert!(!read(&library.join("Trip.md")).contains("Kyoto"));
+    let _ = std::fs::remove_dir_all(&dir);
+}
