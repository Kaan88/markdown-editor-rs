+// ---- N7: a new group whose file name is taken -----------------------------------------------------
+
+#[test]
+fn n7_a_new_group_whose_file_is_there_is_found_out_after_the_notes_are_written() {
+    let dir = scratch("probe-stem");
+    let library = dir.join("library");
+    std::fs::create_dir_all(&library).expect("the library");
+    // A library file called Trip.md whose group has another name.
+    std::fs::write(library.join("Trip.md"), "# Japan 2025\n").expect("a library file");
+    let mut a = app_in(&dir);
+    let source = dir.join("Trip.md");
+    std::fs::write(&source, FLAT).expect("the source");
+    open_now(&mut a, &source);
+    assert!(a.plan_open_active());
+    {
+        let p = a.plan.as_ref().expect("open");
+        assert!(p.dest.is_new, "the screen takes the group for a new one");
+        assert_eq!(p.problem(), None, "and nothing is said against writing");
+    }
+    a.compose();
+    press(&mut a, KeyName::Enter);
+    // FAULT: the notes are on disk and the library cannot list them.
+    assert!(library.join("Trip").join("Asakusa.md").is_file());
+    let said = toast(&a);
+    assert!(
+        said.starts_with("The notes are written, but Trip.md could not be updated"),
+        "{said}"
+    );
+    assert_eq!(read(&library.join("Trip.md")), "# Japan 2025\n");
+    let _ = std::fs::remove_dir_all(&dir);
+}
