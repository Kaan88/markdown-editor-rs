+// ---- N1: undo through the window's own gate -------------------------------------------------------
+
+#[test]
+fn n1_undo_of_notes_under_no_section_deletes_them_and_leaves_their_lines() {
+    let (mut a, library, record, dir) = written("probe-flat", FLAT);
+    let group = library.join("Trip.md");
+    let note = library.join("Trip").join("Asakusa.md");
+    assert!(note.is_file());
+    assert!(read(&group).contains("[Asakusa]"));
+    a.run_undo(record.clone());
+    assert!(!note.exists(), "the notes are deleted");
+    assert!(!library.join("Trip").join("Nara.md").exists());
+    let after = read(&group);
+    // FAULT: both lines are still in the library file, each naming a file that is gone.
+    assert!(after.contains("[Asakusa]") && after.contains("[Nara]"), "{after}");
+    assert_eq!(
+        runs::load(&record, &library).expect("the record").state,
+        State::Undone,
+        "and the run cannot be undone again"
+    );
+    let title =
+        a.ui.results
+            .replace
+            .outcome
+            .as_ref()
+            .map(|o| o.title.clone())
+            .unwrap_or_default();
+    // FAULT: the report says the lines were taken out.
+    assert!(title.contains("2 lines"), "{title}");
+    let _ = std::fs::remove_dir_all(&dir);
+}
