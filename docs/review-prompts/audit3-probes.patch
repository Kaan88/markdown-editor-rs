+// ---- N19: the library was never read ---------------------------------------------------------------
+
+/// Changes the process's working folder, so it runs alone:
+/// `cargo test -p mdedit n19_ -- --ignored --exact --test-threads=1` with the full name.
+#[test]
+#[ignore = "changes the working folder of the process: run it alone"]
+fn n19_split_into_notes_before_the_library_is_read_writes_into_the_working_folder() {
+    let dir = scratch("probe-cwd");
+    let cwd = dir.join("started here");
+    std::fs::create_dir_all(&cwd).expect("a folder");
+    std::env::set_current_dir(&cwd).expect("the working folder");
+    let mut a = app();
+    a.session_path = Some(dir.join("settings.ini"));
+    // No `library_rows()`: the Notes pane was never shown and the palette never opened.
+    let docs = dir.join("docs");
+    std::fs::create_dir_all(&docs).expect("a folder");
+    let source = docs.join("Trip.md");
+    std::fs::write(&source, FLAT).expect("the source");
+    open_now(&mut a, &source);
+    a.command(C::SplitIntoNotes);
+    let root = a.plan.as_ref().expect("the plan opens").root().to_path_buf();
+    // FAULT: the plan's library folder is no folder at all.
+    assert_eq!(root, PathBuf::new());
+    assert_eq!(
+        a.library_dir(),
+        Some(dir.join("library")),
+        "though the window knows where its library is"
+    );
+    a.compose();
+    press(&mut a, KeyName::Enter);
+    // FAULT: the notes, a group file and the records are where the program was started.
+    assert!(cwd.join("Trip").join("Asakusa.md").is_file());
+    assert!(cwd.join("Trip.md").is_file());
+    assert!(cwd.join(".runs").is_dir());
+    assert!(!dir.join("library").join("Trip.md").exists());
+    assert!(!dir.join("library").join("Trip").exists());
+    let _ = std::env::set_current_dir(&dir);
+}
