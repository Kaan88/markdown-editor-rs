+#[test]
+fn n1_the_windows_gate_drops_the_link_removal_when_no_heading_goes_with_it() {
+    let dir = scratch("n1");
+    let library = dir.join("library");
+    let text = "# Trip\nhome: Trip\n\n- [One](Trip/One.md)\n- [Two](Trip/Two.md)\n";
+    let removals = vec![LinkRemoval {
+        path: library.join("Trip/One.md"),
+        sections: Vec::new(),
+        line: "- [One](Trip/One.md)".to_string(),
+    }];
+    // `PlanGate::remove_links` (bins/mdedit/src/app/plan_write.rs:59-63), word for word:
+    let change = |text: &str| -> Option<String> {
+        let without = runs::with_links_removed(text, &removals, &library)
+            .unwrap_or_else(|| text.to_string());
+        runs::with_headings_removed(&without, &[], &library)
+    };
+    // The removal itself works.
+    let without = runs::with_links_removed(text, &removals, &library).expect("the line goes");
+    assert!(!without.contains("[One]"), "{without}");
+    // FAULT: the closure gives `None`, which `library_attempt` reads as "nothing to do".
+    assert_eq!(change(text), None);
+}
