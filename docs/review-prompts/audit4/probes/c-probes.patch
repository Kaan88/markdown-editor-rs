+#[test]
+fn probe_a_name_taken_while_the_answer_was_out_drops_the_card_and_the_answer() {
+    let (mut a, p) = lib("probe-taken");
+    open_card(&mut a, &p);
+    answer(&mut a, "# Pasta\n\nBoil it.\n");
+    let note = target(&a);
+    std::fs::write(&note, "someone else's file\n").unwrap();
+    press(&mut a, KeyName::Enter);
+    eprintln!(
+        "PROBE-N1 card open = {}, toast = {:?}, file = {:?}",
+        a.note.is_some(),
+        toast(&a),
+        read(&note)
+    );
+    let (list, newer) = mdedit_core::runs::list_all(&a.library_dir().unwrap());
+    eprintln!("PROBE-N1 records = {} (+{} unread)", list.len(), newer.len());
+    for r in &list {
+        eprintln!("PROBE-N1 record state = {:?} created = {:?}", r.record.state, r.record.notes.iter().map(|n| n.created).collect::<Vec<_>>());
+    }
+    eprintln!("PROBE-N1 group = {:?}", read(&p.group));
+    assert!(a.note.is_some(), "the card and its answer should stay");
+    let _ = std::fs::remove_dir_all(&p.dir);
+}
+
+#[test]
+fn probe_undo_puts_the_group_file_back_byte_for_byte() {
+    let (mut a, p) = lib("probe-undo-exact");
+    let before = read(&p.group);
+    open_card(&mut a, &p);
+    answer(&mut a, "# Pasta\n\n- Boil it.\n");
+    press(&mut a, KeyName::Enter);
+    let after = read(&p.group);
+    let library = a.library_dir().unwrap();
+    let (list, _) = mdedit_core::runs::list_all(&library);
+    let record = list.first().expect("a record").path.clone();
+    a.run_undo(record);
+    eprintln!("PROBE-N2 before = {before:?}\nPROBE-N2 written = {after:?}\nPROBE-N2 undone = {:?}", read(&p.group));
+    assert_eq!(read(&p.group), before);
+    let _ = std::fs::remove_dir_all(&p.dir);
+}
+
+#[test]
+fn probe_a_group_with_no_home_line_gets_a_folder_and_undo_takes_it_away() {
+    let (mut a, p) = lib("probe-nohome");
+    std::fs::write(&p.group, "# Recipes\n").unwrap();
+    std::fs::remove_dir_all(p.library.join("Recipes")).unwrap();
+    a.library_rows();
+    open_card(&mut a, &p);
+    eprintln!("PROBE-N3 blocked = {:?} target = {:?}", a.note.as_ref().unwrap().blocked, target(&a));
+    answer(&mut a, "# Pasta\n");
+    let note = target(&a);
+    press(&mut a, KeyName::Enter);
+    eprintln!("PROBE-N3 note written = {} group = {:?}", note.is_file(), read(&p.group));
+    let library = a.library_dir().unwrap();
+    let (list, _) = mdedit_core::runs::list_all(&library);
+    let record = list.first().expect("a record").path.clone();
+    a.run_undo(record);
+    eprintln!(
+        "PROBE-N3 after undo: note = {}, folder = {}, group = {:?}",
+        note.exists(),
+        p.library.join("Recipes").exists(),
+        read(&p.group)
+    );
+    assert!(!note.exists());
+    assert!(!p.library.join("Recipes").exists(), "the folder the run made goes too");
+    assert_eq!(read(&p.group), "# Recipes\n");
+    let _ = std::fs::remove_dir_all(&p.dir);
+}
