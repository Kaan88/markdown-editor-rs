+#[test]
+fn probe_rows_made_again_under_a_held_note_move_another_note() {
+    let (mut a, l) = lib("probe-rows");
+    let slash = |p: &std::path::Path| p.to_string_lossy().replace('\\', "/");
+    let mut paths = Vec::new();
+    for n in ["one", "two", "three"] {
+        let p = l.dir.join(format!("{n}.md"));
+        std::fs::write(&p, format!("# {n}\n")).unwrap();
+        paths.push(p);
+    }
+    std::fs::write(
+        &l.file,
+        format!(
+            "# Personal\n\n## A\n\n- [One]({})\n\n## B\n\n- [Two]({})\n- [Three]({})\n\n## Trips\n",
+            slash(&paths[0]),
+            slash(&paths[1]),
+            slash(&paths[2])
+        ),
+    )
+    .unwrap();
+    a.library_rows();
+    a.compose();
+    let two = row_of(&a, "Two");
+    let src = a.hit_rect(Hit::LibraryRow(two)).unwrap();
+    let trips = a.hit_rect(Hit::LibraryRow(row_of(&a, "Trips"))).unwrap();
+    a.ui.mouse = (src.cx(), src.cy());
+    a.left_press();
+    a.drag_to(a.ui.drag.unwrap(), trips.cx(), trips.cy());
+    // The keyboard's row is on "A"; Enter folds it while the note is held.
+    a.ui.library.focused = true;
+    let at_a = row_of(&a, "A");
+    a.ui.library.set_cur(at_a);
+    a.key_pressed(Key::Name(KeyName::Enter), None);
+    a.compose();
+    eprintln!(
+        "PROBE-D2 rows after the key = {:?}",
+        a.ui.library.rows.iter().map(|r| r.label.clone()).collect::<Vec<_>>()
+    );
+    let trips = a.hit_rect(Hit::LibraryRow(row_of(&a, "Trips"))).unwrap();
+    a.ui.mouse = (trips.cx(), trips.cy());
+    a.left_release();
+    let text = read(&l.file);
+    let parsed = mdshared_app::library::parse(&text, &l.dir.join("library"));
+    for e in &parsed.entries {
+        eprintln!("PROBE-D2 {} under {:?}", e.title, e.sections);
+    }
+    eprintln!("PROBE-D2 toast = {:?}", toast(&a));
+    let three = parsed.entries.iter().find(|e| e.title == "Three").unwrap();
+    assert_eq!(three.sections, vec!["B".to_string()], "Three was not the note held");
+    let _ = std::fs::remove_dir_all(&l.dir);
+}
