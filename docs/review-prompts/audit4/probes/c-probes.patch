+#[test]
+fn probe_a_drag_let_go_over_the_editor_at_a_rows_height_still_moves_the_note() {
+    let (mut a, l) = lib("probe-out-y");
+    a.compose();
+    let source = a.hit_rect(Hit::LibraryRow(2)).unwrap();
+    let target = a.hit_rect(Hit::LibraryRow(5)).unwrap();
+    a.ui.mouse = (source.cx(), source.cy());
+    a.left_press();
+    let text = a.areas.text;
+    assert!(text.cx() > target.right(), "the point is outside the pane");
+    a.ui.mouse = (text.cx(), target.cy());
+    a.drag_to(a.ui.drag.unwrap(), text.cx(), target.cy());
+    eprintln!("PROBE-D1 drop mark = {:?}", a.ui.library.drop);
+    a.left_release();
+    eprintln!("PROBE-D1 file changed = {}", read(&l.file) != l.text());
+    eprintln!("PROBE-D1 toast = {:?}", toast(&a));
+    assert_eq!(read(&l.file), l.text(), "let go over the editor: nothing written");
+    let _ = std::fs::remove_dir_all(&l.dir);
+}
