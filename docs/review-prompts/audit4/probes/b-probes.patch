+#[test]
+fn probe_b6_a_write_that_fails_leaves_no_original_in_the_record() {
+    let dir = scratch("probe-b6");
+    let lib = dir.join("library");
+    std::fs::create_dir_all(&lib).expect("library");
+    let text = pasta(&dir);
+    let mut a = app();
+    a.session_path = Some(dir.join("settings.ini"));
+    a.task_open(TaskKind::Rewrite, vec![text.clone()]);
+    a.docs.prefs.ai_connection = Connection::ClaudeApi;
+    engine();
+    if let Some(s) = a.task.as_mut() {
+        s.ai_on = true;
+        s.instruction.set_text("Tidy it");
+    }
+    a.task_run();
+    wait(&mut a, |a| a.ai.panel.is_some());
+    // The file cannot be replaced: read-only (Windows refuses the rename over it).
+    let mut perms = std::fs::metadata(&text).expect("meta").permissions();
+    perms.set_readonly(true);
+    std::fs::set_permissions(&text, perms.clone()).expect("ro");
+    a.task_review_apply();
+    let blocked = match &a.ai.panel {
+        Some(Panel::Review(rv)) => rv.blocked.clone(),
+        _ => None,
+    };
+    let on_disk = std::fs::read_to_string(&text).expect("read");
+    let tmp = dir.join("pasta.md.tmp");
+    let mem = a.task_record.as_ref().map(|(_, r)| r.originals.len());
+    eprintln!("blocked {blocked:?}; file {on_disk:?}; tmp left {}; originals in memory {mem:?}", tmp.exists());
+    a.ai.panel = None;
+    a.task_close();
+    let listed = runs::list(&lib);
+    eprintln!(
+        "records listed after close: {} (originals {:?})",
+        listed.len(),
+        listed.first().map(|r| r.record.originals.len())
+    );
+    #[allow(clippy::permissions_set_readonly_false)]
+    perms.set_readonly(false);
+    let _ = std::fs::set_permissions(&text, perms);
+    assert_eq!(on_disk, "# Pasta\n\nBoil it.\n", "the file was not written");
+    assert!(!tmp.exists(), "no pasta.md.tmp is left beside the owner's file");
+    assert!(listed.is_empty(), "nothing was rewritten, so no record lists an original");
+}
