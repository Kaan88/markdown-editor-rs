+#[test]
+fn probe_b4_a_kept_file_review_applied_after_the_window_was_reopened() {
+    let dir = scratch("probe-b4");
+    std::fs::create_dir_all(dir.join("library")).expect("library");
+    let one = pasta(&dir);
+    let b = dir.join("b.md");
+    let c = dir.join("c.md");
+    std::fs::write(&b, "# B\n\nprivate b\n").expect("b");
+    std::fs::write(&c, "# C\n\nprivate c\n").expect("c");
+    let mut a = app();
+    a.session_path = Some(dir.join("settings.ini"));
+    a.task_open(TaskKind::Rewrite, vec![one.clone()]);
+    a.docs.prefs.ai_connection = Connection::ClaudeApi;
+    engine();
+    if let Some(s) = a.task.as_mut() {
+        s.ai_on = true;
+        s.instruction.set_text("Tidy it");
+    }
+    a.task_run();
+    wait(&mut a, |a| a.ai.panel.is_some());
+    // Escape keeps the review; Escape again closes the window.
+    a.ai_key(Some(KeyName::Escape), None);
+    assert!(a.ai.kept.is_some(), "kept");
+    a.task_key(Some(KeyName::Escape), None);
+    assert!(a.task.is_none(), "closed");
+    // A new window, File them, over two other files. Nothing is run in it.
+    a.task_open(TaskKind::File, vec![b.clone(), c.clone()]);
+    let before = a.task_sent.requests;
+    a.ai_show_kept();
+    a.task_review_apply();
+    assert_eq!(std::fs::read_to_string(&one).expect("one"), "# Done\n");
+    let s = a.task.as_ref().expect("the new window");
+    eprintln!(
+        "b done {} ticked {}, asking {:?}, requests {} -> {}",
+        s.files[0].done,
+        s.files[0].ticked,
+        s.asking.as_ref().map(|x| (x.index, x.prompt.clone())),
+        before,
+        a.task_sent.requests
+    );
+    assert!(!s.files[0].done, "b.md was never run");
+    assert!(s.asking.is_none(), "no request starts from another window's review");
+}
