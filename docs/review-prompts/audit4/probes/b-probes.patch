+#[test]
+fn probe_b8_a_crlf_file_with_a_bom_is_rewritten_and_undone_to_the_byte() {
+    let dir = scratch("probe-b8");
+    let lib = dir.join("library");
+    std::fs::create_dir_all(&lib).expect("library");
+    let p = dir.join("win.md");
+    let original: Vec<u8> = [&[0xEF, 0xBB, 0xBF][..], b"# Pasta\r\n\r\nBoil it.\r\nmixed\nlast"].concat();
+    std::fs::write(&p, &original).expect("win");
+    let mut a = app();
+    a.session_path = Some(dir.join("settings.ini"));
+    a.task_open(TaskKind::Rewrite, vec![p.clone()]);
+    a.docs.prefs.ai_connection = Connection::ClaudeApi;
+    engine();
+    if let Some(s) = a.task.as_mut() {
+        s.ai_on = true;
+        s.instruction.set_text("Tidy it");
+        eprintln!("why {:?} text {:?}", s.files[0].reason_for(TaskKind::Rewrite), s.files[0].text);
+    }
+    a.task_run();
+    wait(&mut a, |a| a.ai.panel.is_some());
+    let Some(Panel::Review(rv)) = &a.ai.panel else { panic!("review") };
+    eprintln!("blocked {:?} result {:?}", rv.blocked, rv.result);
+    a.task_review_apply();
+    let written = std::fs::read(&p).expect("written");
+    eprintln!("written {:?}", String::from_utf8_lossy(&written));
+    let run = runs::list(&lib).remove(0);
+    let report = runs::undo(&run.path, &run.record, &lib, &mut NoGate);
+    assert!(report.refusal.is_none());
+    assert_eq!(std::fs::read(&p).expect("back"), original, "undo restores to the byte");
+}
