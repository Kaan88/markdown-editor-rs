+#[test]
+fn probe_b9_keep_the_folders_after_a_sort_gives_the_folders_back() {
+    let (mut a, l) = lib("probe-b9", &["one.md", "Bread/two.md", "Sauces/three.md"]);
+    open_card(&mut a, &l);
+    let folders = |a: &App| -> Vec<(PathBuf, Vec<String>, bool)> {
+        let mut v: Vec<_> = a
+            .importer
+            .as_ref()
+            .expect("card")
+            .plan
+            .notes
+            .iter()
+            .map(|n| (n.path.clone(), n.sections.clone(), n.ticked))
+            .collect();
+        v.sort();
+        v
+    };
+    let before = folders(&a);
+    sort(&mut a);
+    assert!(matches!(a.importer.as_ref().expect("card").sort, SortStage::Filed { .. }));
+    // Ask again, then "Keep the folders" on the scheme (Escape).
+    ask(&mut a);
+    a.import_sort_back();
+    assert!(matches!(a.importer.as_ref().expect("card").sort, SortStage::Off));
+    let after = folders(&a);
+    eprintln!("before {before:?}\nafter  {after:?}");
+    assert_eq!(after, before, "Keep the folders: each file under its folder's heading again");
+}
