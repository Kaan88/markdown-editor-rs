+#[test]
+fn probe_b3_a_full_rewrite_run_of_crlf_files_can_be_listed_and_undone() {
+    let dir = scratch("probe-b3");
+    let lib = dir.join("library");
+    std::fs::create_dir_all(&lib).expect("library");
+    // 20 files (REWRITE_MAX_FILES) of just under 200,000 bytes (REWRITE_MAX), CRLF, short lines.
+    let line = "- [ ] buy milk and eggs\r\n";
+    let before: String = line.repeat(199_990 / line.len());
+    assert!(before.len() <= crate::task_ui::REWRITE_MAX);
+    let after = before.replacen("milk", "MILK", 1);
+    let mut rec = None;
+    for i in 0..crate::task_ui::REWRITE_MAX_FILES {
+        let p = dir.join(format!("f{i}.md"));
+        std::fs::write(&p, &before).expect("file");
+        if rec.is_none() {
+            rec = Some(runs::start_rewrite(&lib, "x", None, &p).expect("record"));
+        }
+        let (path, record) = rec.as_mut().expect("rec");
+        runs::rewrite_into(
+            path,
+            record,
+            &lib,
+            &runs::RewriteFile {
+                path: p.clone(),
+                before: before.clone(),
+                after: after.clone(),
+                bom: false,
+            },
+        )
+        .expect("written");
+    }
+    let (path, _) = rec.expect("rec");
+    let size = std::fs::metadata(&path).expect("meta").len();
+    let (listed, unread) = runs::list_all(&lib);
+    eprintln!("record bytes {size}, listed {}, unread {}", listed.len(), unread.len());
+    assert_eq!(listed.len(), 1, "the run that rewrote 20 files must be listed so it can be undone");
+}
