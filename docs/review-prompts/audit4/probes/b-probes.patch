+#[test]
+fn probe_b1_a_cyrillic_file_in_file_them_summary() {
+    let dir = scratch("probe-b1");
+    std::fs::create_dir_all(dir.join("library")).expect("library");
+    let p = dir.join("ru.md");
+    // 1,300 two-byte letters after an odd-length ASCII head: byte 2048 falls inside a letter.
+    let text = format!("# T\n{}\n", "\u{0436}".repeat(1300));
+    std::fs::write(&p, text).expect("ru");
+    let mut a = app();
+    a.session_path = Some(dir.join("settings.ini"));
+    a.task_open(TaskKind::File, vec![p]);
+    let s = a.task.as_mut().expect("open");
+    s.ai_on = true;
+    assert_eq!(s.files[0].kind, FileKind::Text);
+    // What the footer draws on every frame, and what Run sends.
+    let d0 = crate::task_ui::digest_of(&s.files[0]);
+    let d1 = {
+        let mut f = s.files[0].clone();
+        f.name = "ru2.md".into();
+        crate::task_ui::digest_of(&f)
+    };
+    eprintln!("digests {} {}", d0.len(), d1.len());
+}
