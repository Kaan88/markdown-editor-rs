+#[test]
+fn probe_b5_the_task_is_switched_while_a_request_is_out() {
+    let dir = scratch("probe-b5");
+    std::fs::create_dir_all(dir.join("library")).expect("library");
+    let text = pasta(&dir);
+    let (mut a, _d) = ai_open("probe-b5-ai", TaskKind::File, vec![text.clone()]);
+    if let Some(s) = a.task.as_mut() {
+        s.instruction.set_text("TASKFILE: by dish");
+    }
+    a.task_run();
+    assert!(a.task.as_ref().expect("open").asking.is_some(), "the filing request is out");
+    a.compose();
+    let centre = a.task.as_ref().and_then(|s| {
+        s.hits
+            .iter()
+            .find(|(h, _)| *h == Hit::Kind(TaskKind::Rewrite))
+            .map(|(_, r)| (r.x + r.w / 2.0, r.y + r.h / 2.0))
+    });
+    let (x, y) = centre.expect("the switch is drawn and can be clicked while asking");
+    a.ui.mouse = (x, y);
+    a.task_press();
+    a.task_release();
+    assert_eq!(a.task.as_ref().expect("open").task, TaskKind::Rewrite, "the click took");
+    let until = Instant::now() + Duration::from_secs(3);
+    while Instant::now() < until && a.ai.panel.is_none() {
+        a.ai_wake();
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    if let Some(Panel::Review(rv)) = &a.ai.panel {
+        eprintln!("REVIEW of {:?}: result = {:?}", rv.spec.title, rv.result);
+    }
+    assert!(a.ai.panel.is_none(), "a filing answer must not become a rewrite of the file");
+}
